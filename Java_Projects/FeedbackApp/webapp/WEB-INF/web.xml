<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- This welcome-file tag is not needed if you have an index.html, but it doesn't hurt -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Define the Servlet -->
    <servlet>
        <servlet-name>FeedbackServlet</servlet-name>
        <!-- This must be the name of your Java class -->
        <servlet-class>FeedbackServlet</servlet-class>
    </servlet>

    <!-- Map the Servlet to a URL -->
    <servlet-mapping>
        <servlet-name>FeedbackServlet</servlet-name>
        <!-- This URL must match the 'action' in your HTML form -->
        <url-pattern>/FeedbackServlet</url-pattern>
    </servlet-mapping>

</web-app>
