{
  "env": {
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 2],
    "quotes": ["error", "single", { "avoidEscape": true, "allowTemplateLiterals": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
    "no-undef": ["error"]
  },
  "overrides": [
    {
      "files": ["src/**/*.js"],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["public/**/*.js"],
      "env": { "browser": true, "node": false }
    }
  ]
}
